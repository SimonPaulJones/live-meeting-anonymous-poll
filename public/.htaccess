# Live Poll: always fetch fresh copies so a redeploy reaches everyone on the call.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
DirectoryIndex index.html

# Settings files: never served
<FilesMatch "^config(\.example)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Poll links: /livepoll/<room id> is served by room.php (a real 404 when the poll doesn't exist)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^([a-f0-9]{16})$ room.php?r=$1 [L,QSA]
</IfModule>
