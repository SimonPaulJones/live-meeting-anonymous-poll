# Copy to scripts/deploy.env (not in git) and fill in.
DEPLOY_SSH=user@example.com            # an ssh host or ~/.ssh/config alias
DEPLOY_PATH=/var/www/html/livepoll     # folder on the server (only this folder is changed)
DEPLOY_URL=https://example.com/livepoll/
DEPLOY_OWNER=                          # optional: chown the files, e.g. www-data:www-data
